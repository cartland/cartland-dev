---
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../lib/site.js'
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for does not exist."
  slug="404"
>
  <section class="not-found">
    <p class="code" aria-hidden="true">404</p>
    <h1>Page Not Found</h1>
    <p>
      The page you are looking for does not exist. Please check the URL for
      mistakes and try again. If you think this is an error, please contact me.
    </p>
    <a class="button primary" href={withBase('')}>Return to homepage</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding-block: 64px;
    max-width: 52ch;
    margin-inline: auto;
  }

  .code {
    font-size: 5rem;
    line-height: 1;
    color: var(--color-text-3);
    margin-bottom: 8px;
  }

  .not-found .button {
    margin-top: 16px;
  }
</style>
