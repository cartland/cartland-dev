---
import { withBase } from '../lib/site.js'

const year = new Date().getFullYear()

const siteLinks = [
  { label: 'About', href: withBase('') },
  { label: 'Projects', href: withBase('projects') },
]

const socialLinks = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/cartland' },
  { label: 'GitHub', href: 'https://github.com/cartland' },
  { label: 'X', href: 'https://x.com/LandOfCart' },
  { label: 'Threads', href: 'https://www.threads.net/@LandOfCart' },
]
---

<footer class="site-footer">
  <div class="container">
    <div class="columns">
      <div class="brand-col">
        <p class="name">Christopher Cartland</p>
        <p class="tagline">
          Software engineer and tech maker — Mobile, Android, Embedded,
          Serverless.
        </p>
      </div>
      <nav aria-label="Footer site links">
        <p class="heading">Site</p>
        <ul>
          {
            siteLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Footer social links">
        <p class="heading">Elsewhere</p>
        <ul>
          {
            socialLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="copyright">
      © {year} Christopher Cartland · <a href="https://chriscart.land"
        >chriscart.land</a
      >
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-soft);
    padding-block: 40px 32px;
    font-size: var(--text-sm);
  }

  .columns {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 32px;
    margin-bottom: 32px;
  }

  .name {
    color: var(--color-text-1);
    font-weight: 500;
    margin-bottom: 4px;
  }

  .tagline {
    color: var(--color-text-3);
    max-width: 36ch;
  }

  .heading {
    color: var(--color-text-1);
    font-weight: 500;
    margin-bottom: 8px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    margin-bottom: 6px;
  }

  a {
    color: var(--color-text-2);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text-1);
    text-decoration: underline;
  }

  .copyright {
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-border-soft);
    color: var(--color-text-3);
    text-align: center;
  }

  .copyright a {
    color: var(--color-text-3);
  }

  @media (width <= 640px) {
    .columns {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
